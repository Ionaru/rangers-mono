{
  "workspace": [
    "./packages/config",
    "./packages/domain",
    "./packages/logging",
    "./packages/db",
    "./packages/discord",
    "./packages/teamspeak",
    "./packages/identity",
    "./apps/web",
    "./apps/worker"
  ],
  "nodeModulesDir": "auto",
  // Deno-only tooling. npm runtime dependencies deliberately do NOT live here:
  // they go in each member's package.json, which is the only manifest Astro's
  // bundler reads. One dependency, one home.
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "tasks": {
    // `deno check` cannot read .astro files, so apps/web is typechecked by
    // `astro check` instead. Both halves run, or the web app's strict tsconfig
    // is enforced nowhere outside an editor and `astro build` only transpiles.
    "check": "deno check packages/config/mod.ts packages/config/env-check.ts packages/domain/mod.ts packages/logging/mod.ts packages/db/mod.ts packages/db/migrate.ts packages/db/import-legacy.ts packages/discord/mod.ts packages/discord/phase0-check.ts packages/discord/register.ts packages/teamspeak/mod.ts packages/identity/mod.ts apps/worker/main.ts apps/worker/badge-backfill.ts apps/worker/ts-check.ts apps/worker/assignable-seed.ts apps/worker/sync-preview.ts apps/worker/op-preview.ts apps/worker/attendance-preview.ts && deno task web:check",
    // apps/ as well as packages/. The worker's internal API is the one
    // authorisation boundary in the system, and it is pure request-handling, so
    // it is testable even though the TeamSpeak connection behind it is not.
    //
    // `apps/web/src` is named SEPARATELY and that is not redundant: apps/web is
    // a package.json-only workspace member (ADR 0006, it has to be, or Astro's
    // bundler cannot resolve @7r/*), and Deno's test discovery walks `apps/`
    // without descending into it. Until this was added, briefing.test.ts had
    // never run in CI; admin.test.ts would have been dead on arrival too.
    "test": "deno test --allow-read --allow-env --allow-write=/tmp packages/ apps/ apps/web/src/",
    "fmt": "deno fmt --unstable-component",
    "fmt:check": "deno fmt --check --unstable-component",
    "lint": "deno lint",
    "db:generate": "deno task --cwd packages/db generate",
    "migrate": "deno task --cwd packages/db migrate",
    "import:legacy": "deno task --cwd packages/db import:legacy",
    // Read-only. Validates a .env against the config schemas: names the missing
    // required keys (a boot failure), the missing-but-defaulted ones, and any set
    // key no schema reads. Prints key names only, never values. Run it before
    // updating the production config, and the deploy runs it as a gate (ADR 0018).
    //   deno task env:check                 # checks the repo-root .env
    //   deno task env:check -- --file <path>
    "env:check": "deno task --cwd packages/config check:env",
    // Read-only. Asks Discord which Phase 0 steps are actually done, because almost
    // every way of getting Phase 0 wrong fails silently.
    "phase0:check": "deno task --cwd packages/discord check:phase0",
    // Phase 5. Registers 7R_Bot's slash commands. Dry-run by default; a bulk PUT
    // of the guild scope is destructive (takes any surviving /loa with it), so it
    // lists both scopes and confirms before writing (-- --apply).
    "commands:register": "deno task --cwd packages/discord commands:register",
    "web:dev": "deno task --cwd apps/web dev",
    "web:build": "deno task --cwd apps/web build",
    "web:check": "deno task --cwd apps/web check",
    "web:preview": "deno task --cwd apps/web preview",
    "worker:dev": "deno task --cwd apps/worker dev",
    // Read-only. Connects and prints the virtual servers this instance actually has,
    // because "invalid serverID" plus a stack trace is not an answer.
    "ts:check": "deno task --cwd apps/worker ts:check",
    // Phase 0, one-shot. Reads the live TeamSpeak badge groups (the only current
    // record of who holds what) and mirrors them into Discord. Dry-run by default.
    "badges:backfill": "deno task --cwd apps/worker badges:backfill",
    // Phase 4. Applies the git-tracked Assignable mapping: resolves sgids live by
    // group name, prints the proposed mapping, and confirms before any write.
    "assignables:seed": "deno task --cwd apps/worker assignables:seed",
    // Read-only. Prints the reconcile diff a live sync pass would apply, without
    // applying anything. Required reading before flipping SYNC_DRY_RUN (ADR 0009).
    "sync:preview": "deno task --cwd apps/worker sync:preview",
    // Phase 5, read-only. Prints the coming Saturday's op (title, window, announce
    // moment) and the exact @everyone message it would post. Required reading
    // before flipping OP_EVENT_DRY_RUN (IMPLEMENTATION §7).
    "op:preview": "deno task --cwd apps/worker op:preview",
    // Phase 6, read-only. Names the channel TS_OPERATIONS_CHANNEL_CID actually
    // points at and lists who is in it. Attendance has no dry-run flag, and a
    // wrong channel id records every op as empty without ever erroring, so this
    // is the check that has to happen before the first Saturday (ADR 0007).
    "attendance:preview": "deno task --cwd apps/worker attendance:preview"
  },
  "fmt": {
    "exclude": [
      "**/dist",
      "**/.astro",
      "packages/db/drizzle",
      "data",
      "node_modules",
      // Markdown is hand-authored prose, and the docs are the spec. deno fmt
      // reflows it, which rewrites every paragraph it touches and buries a real
      // edit in 1,800 lines of rewrapping. Formatting is for code.
      "**/*.md"
    ]
  },
  "lint": {
    "exclude": [
      "**/dist",
      "**/.astro",
      "packages/db/drizzle",
      "data",
      "node_modules"
    ],
    "rules": {
      // no-slow-types exists to keep JSR from having to infer types when it
      // publishes a package. These packages carry `name`/`exports` only so that
      // Deno's workspace resolver can find them; they are internal and will
      // never be published, so the rule is asking for annotations that buy us
      // nothing.
      "exclude": ["no-slow-types"]
    }
  },
  "exclude": ["node_modules", "**/dist", "**/.astro"]
}
