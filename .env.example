# Reference for every config key. It is NOT copied to .env on the deployed box.
# See IMPLEMENTATION.md §2, ADR 0014 and ADR 0018.
#
# Production config lives in the GitHub `production` Environment (ADR 0018). Each key
# below is tagged [VAR] or [SECRET]:
#   [VAR]    an environment VARIABLE  - non-secret, viewable and editable in the UI
#   [SECRET] an environment SECRET    - a credential, write-only
# The deploy assembles .env from those and writes it to the box; do NOT hand-edit the
# box .env (it is overwritten every deploy). Change a value = edit the one
# variable/secret; add a key = add one. `deno task env:check` (and the deploy's own
# gate) names any required entry that is missing.
#
# Two keys stay OUT of GitHub and remain file-based Compose `secrets:` in ./secrets/
# (ADR 0014): the postgres password, and DATABASE_URL. Containers read the URL via
# DATABASE_URL_FILE (a mounted `X_FILE` beats an `X` for any key), so the generated
# .env omits DATABASE_URL entirely.
#
# This file is also the template for a LOCAL dev .env (copy the keys you need). For
# that local file, two write-it-wrong traps still apply:
#
#   Quote anything containing `$`. Compose expands it in an unquoted or double-quoted
#   value, so SESSION_SECRET=abc$def reaches the container as `abc`. Single quotes
#   survive: SESSION_SECRET='abc$def'. (The deploy single-quotes every assembled
#   value for exactly this reason.)
#
#   Never leave a key blank (`FOO=`). Comment it out instead. A blank is read as "not
#   configured" (packages/config/load.ts), so it is not an error, just not meant.
#
# Config fails loud at boot: a service that needs a value and cannot find it exits,
# naming everything that was wrong, rather than starting half-configured. Each group
# below is only required by the phase that reads it.

# ---------------------------------------------------------------- Core (Phase 1)
# Local only, and it is what the host-side tasks (`deno task migrate`,
# `import:legacy`, `web:dev`, `worker:dev`) dial: they load this file with
# --env-file. Inside Compose this same key is overridden by ./secrets/database_url
# via DATABASE_URL_FILE, which beats whatever is set here.
#
# The password must MATCH ./secrets/postgres_password, which is what the postgres
# container is actually started with. They are two files saying the same thing,
# and when they disagree every host-side task fails with "password authentication
# failed for user 7r" while the containers carry on working perfectly.
# DATABASE_URL is NOT a GitHub entry: on the box it comes from ./secrets/ via
# DATABASE_URL_FILE, and this localhost value exists only for local-dev host tasks.
DATABASE_URL=postgres://7r:change-me@localhost:5432/7r
PUBLIC_BASE_URL=http://localhost:8085            # [VAR]
LOG_LEVEL=info                                   # [VAR]

# ------------------------------------------------------------- Worker (Phase 1)
WORKER_INTERNAL_PORT=8080                         # [VAR]

# ------------------------------------------------------- Discord (Phases 2 & 5)
# The four app values below all come from ONE Discord application: 7R_Bot, ours,
# already in the guild, previously the /loa bot. The 2019 bot's account and token
# are not reused (ARCHITECTURE §7, ADR 0015).
#
# A third silent way to get this wrong, on top of the two at the top of the file:
# take the token from one application and the public key from another. Every
# interaction then 401s, and Discord responds by removing the endpoint URL, which
# presents as the bot going quiet rather than as an error.
# DISCORD_GUILD_ID=305471712546390017             # [VAR] the guild does not change
# DISCORD_CLIENT_ID=                              # [VAR] 7R_Bot's application id: OAuth login AND command registration
# DISCORD_CLIENT_SECRET=                          # [SECRET] same application
# DISCORD_BOT_TOKEN=                              # [SECRET] 7R_Bot's (Bot -> Reset Token), NOT the 2019 bot's
# DISCORD_PUBLIC_KEY=                             # [VAR] interactions Ed25519 verify (a PUBLIC key); same application as the token
# DISCORD_ADMIN_ROLE_IDS=                         # [VAR] comma-separated; admin is a single boolean derived from these
# SESSION_SECRET=                                 # [SECRET] Better Auth cookie signing
# ARMA_SERVER_PASSWORD=                           # [SECRET] what /server hands to members. Every member knows it, which
#                                                 # does not make it publishable: this repo is public. The current value
#                                                 # already is, and stays so, knowingly (ARCHITECTURE §7). Keeping it here
#                                                 # rather than in source is what makes changing it cheap if that ever bites.

# ---------------------------------------------------------- Steam (Phase 2)
# Steam OpenID is stateless: no API key is needed to log in.
# STEAM_REALM=https://7th-ranger.com              # [VAR]

# ----------------------------------------------- Web -> worker API (Phase 2)
# The Compose network only: never proxied, never public. Both services need the
# token: `web` sends it, `worker` checks it, and the worker now REFUSES TO BOOT
# without it, because an unauthenticated /internal/ts/poke is a way for anyone on
# the Compose network to spray a link code at any client on the TeamSpeak server.
# WORKER_INTERNAL_URL=http://worker:8080          # [VAR]
# WORKER_INTERNAL_TOKEN=                          # [SECRET] shared between web and worker

# --------------------------------------------- TeamSpeak (Phases 2, 4 & 6)
# Needed from Phase 2, not Phase 4: the identity link flow ("pick yourself from
# the list, the bot pokes you a code") needs a LIVE ServerQuery connection to
# list online clients and poke one. The worker holds that connection, so it
# needs all of this to boot. Phase 4 adds the group reconcile on top of it, and
# Phase 6 the attendance sampling.
# TS_QUERY_HOST=ts.7th-ranger.com                 # [VAR]
# TS_QUERY_PORT=10022                             # [VAR] SSH. NEVER 10011: raw ServerQuery is cleartext and this host is public
# TS_QUERY_USER=                                  # [SECRET]
# TS_QUERY_PASS=                                  # [SECRET]
#
# The `sid`, which is an internal counter and NOT the voice port, and NOT
# reliably 1. This example used to suggest 1, and that cost a red deploy: ours is
# 4, because a virtual server was deleted and remade at some point and the new one
# took the next number. Do not guess it, ask the server:
#
#   deno task ts:check
#
# It lists the virtual servers this instance actually has. Guess wrong and the
# worker dies at boot with "invalid serverID", which fails its healthcheck, which
# fails `docker compose up --wait`, which fails the whole deploy.
# TS_VIRTUALSERVER_ID=                            # [VAR]
# TS_BOT_NICKNAME=7R Bot                          # [VAR] the ServerQuery client's nickname. NOT 7R_Bot the Discord app (CONTEXT.md)

# ------------------------------------------------- Attendance channel (Phase 6)
# Deliberately not in the TeamSpeak block above: nothing in the link flow has any
# use for it, and folding it in would force whoever sets up linking to invent a
# channel id just to get past a fail-loud config.
# TS_OPERATIONS_CHANNEL_CID=                      # [VAR] the single Operations channel

# --------------------------------------------------- Role sync (Phase 4)
#
# Operator to-do, not a setting: add this box's IP to `query_ip_allowlist.txt` on
# the TeamSpeak server (then `serverquery` reload) to lift the 10-commands-per-3s
# flood limit. Nothing here breaks without it, because the worker paces itself
# under the limit either way, and it keeps pacing whether or not the allowlist is
# in place (it has no way to tell). What the allowlist buys is headroom on the
# server side: traffic the worker cannot see, a second tool, or a burst it did
# not account for, can no longer provoke a 524. The worker logs `gateWaitMs` per
# pass, which is what the pacing costs; it stays non-zero either way.
# ROLE_SYNC_INTERVAL_SECONDS=300                  # [VAR]
# SYNC_DRY_RUN=true                               # [VAR] start true; flip only after a preview looks right
# SYNC_MAX_REMOVALS=5                             # [VAR] blast-radius guard: a pass touching more members than this HALTS

# ------------------------------------------- Ops & attendance (Phases 5 & 6)
# Saturday only. Mission time 20:00-23:00; the Discord event runs to 23:30.
# All of the Ops keys are [VAR] (none are secret).
# OP_TIMEZONE=Europe/Amsterdam
# OP_WEEKLY_CRON=0 20 * * 6                       # legacy field; NOT what drives event creation (see below)
# OP_ATTENDANCE_START=20:00
# OP_ATTENDANCE_END=23:00
# OP_EVENT_END=23:30
# ATTENDANCE_MIN_MINUTES=60
# ATTENDANCE_SAMPLE_SECONDS=90
#
# Weekly event creation + announcement (Phase 5). Every announce weekday the worker
# creates the coming Saturday's Discord scheduled event (title "20:00 CEST/CET -
# Saturday Operation", location "7R Operations Server", a random in-game image as
# its cover banner) and posts an @everyone in #arma_general with the event link. The
# timing is a DST-correct reconciler keyed on the two ANNOUNCE fields, not
# OP_WEEKLY_CRON. This is the ONE new required value: the worker fails loud without it.
# OP_ANNOUNCE_CHANNEL_ID=                         # REQUIRED; the #arma_general channel id
# OP_ANNOUNCE_WEEKDAY=3                           # 0=Sun .. 6=Sat; 3 = Wednesday
# OP_ANNOUNCE_TIME=18:00                          # local time on that weekday to fire
#
# Optional flavour, both degrade gracefully if unset/missing. The witty line goes in
# the @everyone message; the image becomes the EVENT's cover banner (a bad/oversized
# image is dropped and the event is still created). The image dir must be readable by
# the worker: mount it into the container (a read-only bind mount in compose.yaml)
# and point this at the in-container path.
# OP_ANNOUNCE_TEXT_FILE=/app/announce-assets/lines.txt   # one witty line per line, picked at random
# OP_ANNOUNCE_IMAGE_DIR=/app/announce-assets/images      # png/jpg/gif, picked at random, used as the event cover
#
# Starts true, like SYNC_DRY_RUN: the worker logs what it would create and post but
# writes nothing and calls no Discord endpoint. The first live pass @everyone-pings
# the whole guild, so review `deno task op:preview` first, then flip to false.
# The bot also needs CREATE_EVENTS (guild) and, in #arma_general, Send Messages +
# Mention @everyone (+ Read Message History, so it can skip re-posting after a crash).
# OP_EVENT_DRY_RUN=true

# --------------------------------------------------------- Alerts (Phase 2)
# SECRET; the worker posts its own errors here. Make it in Discord: Server
# Settings -> Integrations -> Webhooks -> New Webhook, pointed at a private
# staff channel. Anyone holding the URL can post to that channel.
#
# Optional, and treated as such: if it is unset the worker logs to stdout and
# carries on. It is not worth refusing to boot over, and a fail-loud config that
# demands a webhook nobody has made yet is how people learn to paste junk into
# these files.
# ERROR_ALERT_DISCORD_WEBHOOK=https://discord.com/api/webhooks/<id>/<token>   # [SECRET]
