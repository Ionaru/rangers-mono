{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  // Test files run under `node --test` and are type-checked by the root
  // tsconfig.json (the first half of `pnpm check`), which has the Node types
  // they need; `astro check` would check them in Astro's context instead.
  "exclude": ["dist", "**/*.test.ts"]
}
