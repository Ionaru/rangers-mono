---
import Base from "../layouts/Base.astro";
import { loadMemberAttendance } from "../lib/attendance.ts";
import { isAdminDiscordUser } from "../lib/admin.ts";

/**
 * The member's profile: their three identities, and the buttons to link and
 * unlink Steam.
 *
 * TeamSpeak is shown but not operated from here: `/link` and `/unlink` in
 * Discord own that flow, and the web pages that used to run it are gone (ADR
 * 0017). Read-only otherwise, and that is the whole shape of the member area
 * (ADR 0009): no admin panel, no role editing, no roster management. Roles live
 * in Discord and are changed there.
 */
const member = Astro.locals.member!;

/**
 * Set by the Steam link and unlink routes, so the member is told what happened.
 * TeamSpeak has no entries here any more: its outcomes are reported in Discord,
 * by the command that caused them.
 */
const notice = Astro.url.searchParams.get("notice");
const error = Astro.url.searchParams.get("error");

const NOTICES: Record<string, string> = {
  steam_linked: "Steam linked.",
  steam_unlinked: "Steam unlinked.",
};

const ERRORS: Record<string, string> = {
  steam_taken:
    "That Steam account is already linked to another member. If it is really yours, ask an admin.",
  steam_failed: "Steam could not confirm that login. Nothing was changed.",
};

/**
 * A link carried over from the old site is a claim, not a proof: nobody poked
 * anybody to establish it. Say so, and invite them to fix it, rather than
 * quietly presenting it as verified.
 */
const tsUnverified = member.tsLinkMethod === "legacy_import" ||
  member.tsLinkMethod === "manual";
const steamUnverified = member.steamLinkMethod === "manual";

/**
 * Your own attendance (Phase 6). A statistic and nothing else: it gates no
 * promotion and triggers no removal (ADR 0010).
 *
 * Loaded even for a member with no TeamSpeak link, so the panel can say *why*
 * the number is zero. "0 of 12" and "you have never linked TeamSpeak, so nothing
 * could be recorded" are very different messages, and only the second is true.
 */
/**
 * Concurrent: the admin check is a Discord round trip and the attendance load is
 * a pair of database queries, and neither needs the other's answer. Serialised,
 * the profile page would pay both latencies end to end.
 */
const [attendance, isAdmin] = await Promise.all([
  loadMemberAttendance(member.id, member.discordId),
  // The unit-wide view is admin-only, so only admins are shown the way to it.
  isAdminDiscordUser(member.discordId),
]);
---

<Base title="Profile" member={member}>
  <h1>Your profile</h1>

  {notice && NOTICES[notice] && <p class="notice ok">{NOTICES[notice]}</p>}
  {error && ERRORS[error] && <p class="notice bad">{ERRORS[error]}</p>}

  <div class="panel">
  <div class="row">
    <div>
      <h2>Discord</h2>
      <p class="muted">
          {member.displayName} &middot; <code>{member.discordId}</code>
        </p>
    </div>
    <span class="muted">how you sign in</span>
  </div>
</div>

  <div class="panel">
  <div class="row">
    <div>
        <h2>TeamSpeak</h2>
        {member.tsUid
          ? (
            <p class="muted">
              {member.tsNickname ?? "(no nickname)"} &middot;{" "}
              <code>{member.tsUid}</code>
              {tsUnverified
                ? (
                  <>
                    <br />
                    <strong>Not verified.</strong>{" "}
                    {member.tsLinkMethod === "legacy_import"
                      ? "Carried over from the old site."
                      : "Set by an admin."}{" "}
                    Re-link to prove it is yours.
                  </>
                )
                : <><br />Verified.</>}
            </p>
          )
          : (
            <p class="muted">
              Not linked. This is what gives you your TeamSpeak groups, so it is
              worth doing.
            </p>
          )}
      </div>

    <div>
      <p class="muted">
          {member.tsUid
            ? (
              <>
                Run <code>/link</code> in Discord to link it again, or{" "}
                <code>/unlink</code> to remove it.
              </>
            )
            : (
              <>
                Run <code>/link</code> in Discord. You need to be connected to
                TeamSpeak at the time.
              </>
            )}
        </p>
    </div>
  </div>
</div>

  <div class="panel">
  <div class="row">
    <div>
        <h2>Steam</h2>
        {member.steamId
          ? (
            <p class="muted">
              <code>{member.steamId}</code>
              {steamUnverified
                ? (
                  <>
                    <br />
                    <strong>Not verified.</strong>{" "}
                    Carried over from the old site. Re-link to prove it is yours.
                  </>
                )
                : <><br />Verified.</>}
            </p>
          )
          : (
            <p class="muted">
              Optional. It lets other members find you in Steam, and nothing else.
            </p>
          )}
      </div>

    <div>
        <a class="button" href="/link/steam">
          {member.steamId ? "Re-link" : "Link Steam"}
        </a>
        {member.steamId && (
          <form class="inline" method="post" action="/unlink/steam">
            <button type="submit" class="secondary">Unlink</button>
          </form>
        )}
      </div>
  </div>
</div>

  <div class="panel">
    <div class="row">
      <div>
        <h2>Attendance</h2>
        <p class="muted">
          {attendance.consideredOps === 0
            ? "No ops recorded yet."
            : `The last ${attendance.consideredOps} ${
              attendance.consideredOps === 1 ? "op" : "ops"
            }.`}{" "}
          You are credited for an op with at least {attendance.minMinutes}{" "}
          minutes in the Operations channel between 20:00 and 23:00. It is a
          statistic: nothing acts on it.
        </p>
      </div>
      <div>
        <p class="muted">
          <strong>{attendance.creditedOps}</strong> credited &middot;{" "}
          <strong>{attendance.attendedOps}</strong> attended
          <br />
          last attended {attendance.lastAttended ?? "never"}
        </p>
      </div>
    </div>

    {!member.tsUid && (
      <p class="notice bad">
        You have not linked TeamSpeak, so nothing can be recorded against you.
        Run <code>/link</code>{" "}
        in Discord. Any evenings you already attended are credited to you
        automatically the moment you do.
      </p>
    )}

    {attendance.operations.length === 0
      ? <p class="muted">No ops have been recorded yet.</p>
      : (
        <div class="scroll">
          <table>
            <thead>
              <tr>
                <th>Op</th>
                <th class="num">Minutes</th>
                <th>Credited</th>
                <th>Said you were coming</th>
              </tr>
            </thead>
            <tbody>
              {attendance.operations.map((op) => (
                <tr>
                  <td>
                    {op.date}
                    {!op.sampled && (
                      <>
                        {" "}<span class="guest" title="No samples were recorded for this op, so nobody's attendance was measured.">not sampled</span>
                      </>
                    )}
                  </td>
                  <td class="num">{Math.round(op.minutes)}</td>
                  <td class={op.credited ? "yes" : "no"}>
                    {op.credited ? "yes" : "no"}
                  </td>
                  <td class={op.responded ? "yes" : "no"}>
                    {op.responded ? "yes" : "no"}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
  </div>

  {isAdmin && (
    <p class="muted">
      <a href="/attendance">Unit-wide attendance</a>
    </p>
  )}

  <form method="post" action="/signout">
  <button type="submit" class="secondary">Sign out</button>
</form>
</Base>
