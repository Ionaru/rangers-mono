---
/**
 * The shell. Deliberately plain.
 *
 * Phase 2 has no public content and Phase 3 owns the branding, the handbook and
 * the actual design (ARCHITECTURE §9). Anything invested in making this pretty
 * now is work Phase 3 throws away, so this is legible, accessible, and nothing
 * more: system fonts, one column, no framework, no client-side JavaScript
 * anywhere in this app.
 */
interface Props {
  title: string;
  member?: { displayName: string } | null;
  /**
   * Widen the column past the 46rem the member area reads at.
   *
   * One page needs it: the attendance view, whose per-op table is a date, three
   * counts and three lists of names and simply does not fit. Everything else
   * stays at the reading width, which is the point of having a default.
   */
  wide?: boolean;
}

const { title, member = null, wide = false } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | 7th Ranger Group</title>
    <!--
      `is:global`, and it is load-bearing rather than lazy.

      Astro scopes a component's styles to that component's OWN elements, by
      rewriting every selector to `.panel:where(.astro-xxxx)` and stamping the
      hash onto the elements in this file. Page content arrives through `<slot />`
      and carries the page's hash, not this one, so without `is:global` every
      class here (`.panel`, `.row`, `button`, `.notice`, the tables) silently
      matched nothing at all and the member area rendered as unstyled text on a
      dark background. Only the shell itself (`body`, `header`, `main`) was ever
      styled, because those elements are in this template.

      The CSS only ships with pages that use this layout, which is the member
      area; the public site has its own tokens and stylesheets (PublicLayout),
      so "global" here is global to the member area and to nothing else.
    -->
    <style is:global>
    :root {
      color-scheme: dark;
      --bg: #14181c;
      --panel: #1c2228;
      --line: #2c343c;
      --text: #e6e9ec;
      --muted: #8b97a3;
      --accent: #7aa2c8;
      --ok: #7fbf7f;
      --bad: #d98a8a;
    }
    * {
      box-sizing: border-box;
    }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font: 16px/1.55 system-ui, -apple-system, "Segoe UI", sans-serif;
    }
    main {
      max-width: 46rem;
      margin: 0 auto;
      padding: 2rem 1.25rem 4rem;
    }
    header {
      border-bottom: 1px solid var(--line);
      padding: 1rem 1.25rem;
    }
    header .inner {
      max-width: 46rem;
      margin: 0 auto;
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
    }
    header a {
      color: var(--text);
      text-decoration: none;
      font-weight: 600;
    }
    h1 {
      font-size: 1.5rem;
      margin: 0 0 1.5rem;
    }
    h2 {
      font-size: 1.05rem;
      margin: 0 0 .35rem;
    }
    a {
      color: var(--accent);
    }
    .muted {
      color: var(--muted);
    }
    .panel {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 1rem 1.15rem;
      margin-bottom: 1rem;
    }
    .row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }
    button,
    .button {
      font: inherit;
      background: var(--accent);
      color: #10141a;
      border: 0;
      border-radius: 6px;
      padding: .5rem .9rem;
      cursor: pointer;
      font-weight: 600;
      text-decoration: none;
      display: inline-block;
    }
    button.secondary,
    .button.secondary {
      background: transparent;
      color: var(--muted);
      border: 1px solid var(--line);
    }
    .notice {
      border-left: 3px solid var(--accent);
      padding-left: .8rem;
      margin-bottom: 1rem;
    }
    .notice.ok {
      border-color: var(--ok);
    }
    .notice.bad {
      border-color: var(--bad);
    }
    code {
      background: #10141a;
      padding: .1rem .35rem;
      border-radius: 4px;
    }
    form.inline {
      display: inline;
    }
    /**
     * Tables. Phase 6 is the first thing in the member area that has rows rather
     * than records, and they live here rather than scoped to a page so the
     * profile's attendance card and the attendance view cannot drift apart.
     */
    .scroll {
      overflow-x: auto;
    }
    table {
      border-collapse: collapse;
      width: 100%;
      font-variant-numeric: tabular-nums;
    }
    th,
    td {
      text-align: left;
      padding: .4rem .6rem .4rem 0;
      border-bottom: 1px solid var(--line);
      vertical-align: top;
    }
    th {
      color: var(--muted);
      font-weight: 600;
      font-size: .85rem;
      white-space: nowrap;
    }
    td.nowrap,
    th.nowrap {
      white-space: nowrap;
    }
    td.num,
    th.num {
      text-align: right;
      padding-right: 1rem;
      white-space: nowrap;
    }
    tr:last-child td {
      border-bottom: 0;
    }
    .yes {
      color: var(--ok);
    }
    .no {
      color: var(--muted);
    }
    .guest {
      color: var(--bad);
    }
    .wide main,
    .wide header .inner {
      max-width: 68rem;
    }
    </style>
  </head>
  <body class={wide ? "wide" : undefined}>
    <header>
      <div class="inner">
        <a href="/">7th Ranger Group</a>
        {member && <span class="muted">{member.displayName}</span>}
      </div>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
